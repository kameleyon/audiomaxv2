# =============================================================================
# audiomax.ai — .env.example
#
# Copy to `.env` and fill in. `.env` is gitignored (.gitignore:22) and
# `.env.example` is re-included by the `!.env.example` exception on the line
# below it, so this file is the ONLY one of the pair that is ever committed.
#
# THERE ARE NO REAL VALUES IN THIS FILE AND THERE MUST NEVER BE ONE.
# Every value below is a placeholder or empty. Jury J-M5: key material must
# never be one typo away from a commit.
#
# -----------------------------------------------------------------------------
# FORMAT MATTERS HERE, AND NOT FOR STYLE.
#
# `aligner/spike-a/reference.py:29-36` parses the repo-root `.env` itself with
# `line.split("=", 1)` and `.strip()`. It does NOT understand `export`, quoting,
# escapes, multi-line values or interpolation. A value written as "abc" arrives
# at the provider as the six characters `"abc"` and authentication fails with a
# message that blames the key. So:
#
#   KEY=value          yes
#   KEY="value"        no — the quotes become part of the key
#   export KEY=value   no — the name becomes `export KEY`
#
# -----------------------------------------------------------------------------
# WHO ADDS WHAT. This file is completed as features are built, by the owner of
# the feature — not retrofitted. Sections are ordered by phase. A variable
# appears here on the day the code that reads it lands, with a file:line
# citation, so that "every variable" is checkable rather than asserted.
# =============================================================================


# -----------------------------------------------------------------------------
# SCHEMA + MIGRATIONS  (Phase 0/1 · Owner: Atlas)
#
# Consumed by the Supabase CLI and by supabase/tests/verify_voice_langs.mjs.
# None of these is read by application code.
# -----------------------------------------------------------------------------

# Supabase CLI authentication (`supabase login` stores this itself; set it only
# for non-interactive/CI use). Personal access token, NOT a project API key.
SUPABASE_ACCESS_TOKEN=

# The project this repository links to (`supabase link --project-ref …`).
# Twenty lowercase letters. NOT a URL.
SUPABASE_PROJECT_REF=

# Database password for the linked project, used by `supabase db push`.
SUPABASE_DB_PASSWORD=

# Postgres connection string for supabase/tests/verify_voice_langs.mjs in live
# mode. The default below is the LOCAL Supabase stack. That script refuses any
# non-loopback host unless `--allow-remote` is also passed, because a rollback
# is still a connection to a live project.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# -----------------------------------------------------------------------------
# SPIKE HARNESS KEYS — SPIKE A (Forge) and SPIKE C (Oracle)
#
# These are the keys the code ON DISK reads today. Every one is a PAID API.
# Per the working agreement: one call first, verify the cost, then scale.
#
# CITED BY FILE AND SYMBOL, NOT BY LINE (J31-M2). Every locator below is
# reproducible with `grep -rln "<VAR>" aligner/`; line numbers were removed on
# 2026-08-10 because they pointed into files a concurrent author was reflowing,
# and two of them were already wrong when they were read.
#
# NOTE: these are HARNESS keys, not the product provider set. Spec §3.5 routes
# `en` -> Lemonfox and `es`/`fr` -> Fish `s2-pro`, and audiomax routes NOTHING
# to Gemini or Google (CLAUDE.md constraint 7).
# -----------------------------------------------------------------------------

# Lemonfox — ASR reference words, and a TTS provider for some fixtures.
# Read by: aligner/spike-a/{reference,fa,wx,calibrate,tts,groundtruth}.py
LEMONFOX_API_KEY=

# Fish Audio — TTS. Read by: aligner/spike-a/{tts,voices,groundtruth}.py and
# aligner/spike-c/probe.py.
# BILLS UTF-8 BYTES, NOT CHARACTERS — CONFIRMED 2026-08-10 by SPIKE C, one
# billed call: 590 bytes charged $0.008850, byte model residual $0.000000,
# character model wrong by 34%. Evidence: aligner/spike-c/artifact.json.
# The `es`/`fr` quote is understated ~2.4-2.8% if computed from characters.
FISH_AUDIO_API_KEY=

# OpenRouter — read by aligner/spike-a/tts.py ONLY, and only for the Gemini
# TTS path that SPIKE A used for `es`/`fr` BEFORE that routing was found to be
# wrong (J29-C3). It is a HARNESS key with no product route behind it: `ht`
# left scope (docs/architecture/0005) and Gemini left with it, so audiomax
# sends nothing to Google. `es`/`fr` are Fish `s2-pro`.
#   Product-side disclosure, for when the product path is built: text reaches
#   an LLM via OpenRouter, and the LLM's MODEL HOST is not yet chosen and so
#   cannot be named (Comply with Forge, due 2026-08-15). Google is NOT a
#   subprocessor of audiomax. This comment claimed it was, and named "the
#   Gemini TTS path" as though it were ours, until 2026-08-10.
OPENROUTER_API_KEY=

# Hypereal — second ASR engine, for cross-engine agreement.
# Read by: aligner/spike-a/hypereal.py. The endpoint is a module constant in
# that file, NOT an environment variable — do not add HYPEREAL_URL here
# expecting it to be read.
HYPEREAL_API_KEY=


# -----------------------------------------------------------------------------
# PROCESS ENVIRONMENT ONLY — deliberately NOT read from this file
#
# `HOLDOUT` (read by aligner/spike-a/tts.py and calibrate.py — `grep -rn HOLDOUT
# aligner/`) is read via os.environ, not via the `.env`
# parser, so setting it here has no effect. Pass it on the command line:
#     HOLDOUT=1 python aligner/spike-a/tts.py
# It is listed so that its absence from the sections above is a decision on the
# record rather than an omission.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# NO PRODUCT VARIABLES YET
#
# CORRECTED 2026-08-10. This read "The worker, web and mobile workspaces do not
# exist yet (roadmap:381-383)". ALL THREE EXIST — `worker/`, `apps/web/` and
# `apps/mobile/` are pnpm workspaces with 57, 5 and 5 tests. What is true is
# narrower: no PRODUCT feature is implemented, so none of them reads a variable
# beyond `PORT` / `HOST` (see the worker/aligner section above).
#
# Nothing is listed here in anticipation: a placeholder for a variable no code
# reads is indistinguishable from a variable somebody forgot to wire up, and
# this project has already paid for that distinction more than once. Add the
# section with the code, and cite it BY FILE AND SYMBOL — not by line number
# (J31-M2). This block's own `roadmap:381-383` had drifted to a different
# section by the time anyone checked it, which is the whole argument.
# -----------------------------------------------------------------------------
